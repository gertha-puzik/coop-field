{
  "name": "coop-field",
  "private": true,
  "version": "0.2.0",
  "description": "abnocw canvas on the coop-field WebSocket room",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:grotto": "NEXT_PUBLIC_SITE=grotto next build",
    "build:elyria": "NEXT_PUBLIC_SITE=elyria next build",
    "build:variants": "npm run build:grotto && node scripts/prune-export.mjs grotto && npm run build:elyria && node scripts/prune-export.mjs elyria",
    "start": "node server.js",
    "test:ws": "node scripts/test-ws.mjs",
    "test:queue": "node scripts/test-move-queue.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:profiles": "node scripts/test-profiles.mjs",
    "test:cfg": "node scripts/test-cfg-registry.mjs",
    "test:preview-slug": "node scripts/test-preview-slug.mjs",
    "test:preview-apply": "node scripts/test-preview-apply.mjs",
    "test:preview-pr-link": "node scripts/test-preview-pr-link.mjs",
    "test:write-openssh-key": "node scripts/test-write-openssh-key.mjs",
    "test:elev": "node scripts/test-elev-cliff.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:server-modules": "node scripts/test-server-modules.mjs",
    "test:protocol-parity": "node scripts/test-protocol-parity.mjs",
    "check:protocol": "node scripts/check-protocol-sync.mjs",
    "check:landmarks": "node scripts/check-doc-landmarks.mjs",
    "arch:check": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "map:restore": "node scripts/set-local-map.mjs backups/prod-elysia-map-2026-11-06.json",
    "map:restore-2": "node scripts/set-local-map.mjs backups/prod-elysia-map-2026-11-06-2.json",
    "map:dump": "node scripts/dump-vps-map.mjs data/fresh-map.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.1.1",
    "pixi.js": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
