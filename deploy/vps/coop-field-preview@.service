# Шаблон preview-комнаты. %i — DNS-slug ветки.
# Не ставить вместо coop-field.service (это прод).
# Пользователь deploy-preview — не deploy прода.
# EnvironmentFile: /opt/coop-field-preview/%i/env
# (PORT, DATA_DIR, хосты/Origin превью). Прод-секреты сюда не копируются.

[Unit]
Description=coop-field preview (%i)
After=network.target

[Service]
User=deploy-preview
Group=deploy-preview
WorkingDirectory=/opt/coop-field-preview/%i
EnvironmentFile=/opt/coop-field-preview/%i/env
ExecStart=/opt/coop-field/.node/bin/node server.js
Restart=on-failure
RestartSec=2
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
